---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleBrowser from '../components/ArticleBrowser.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

---

<Base
  title="出海产品合规、真实案例与风险清单"
  description="面向中国出海中小企业，关注欧盟、东南亚、中东与拉美。结合公开案例、一手法规和行动清单，解释产品安全、知识产权与清关风险；目前已刊内容聚焦欧盟。"
>
  <section class="masthead">
    <p class="kicker">COMPLIANCE · CASES · GOING GLOBAL</p>
    <h1>出海合规观察</h1>
    <p class="sub">
      发货前该准备什么，产品被通报后该查哪里，商标投诉要留哪些证据？
      本站把公开案例、一手法规和行动清单连起来，帮助中国中小企业判断下一步。
      <strong>关注四大市场，目前已刊内容聚焦欧盟。</strong>
    </p>
    <p class="markets">
      <span>关注市场</span>
      <span>欧盟 EU</span><span>东南亚 SEA</span><span>中东 GCC</span><span>拉美 LATAM</span>
    </p>
  </section>

  <ArticleBrowser articles={articles} />
</Base>
