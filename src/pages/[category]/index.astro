---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleBrowser from '../../components/ArticleBrowser.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'cases', name: '案例分析', desc: '真实出海纠纷与知识产权侵权案件深度解读：案情、金额、结果与中小企业启示。' },
    { slug: 'guides', name: '法规解读', desc: '欧盟、东南亚、中东、拉美产品合规、认证、数据与报关要求的实操解读。' },
    { slug: 'checklists', name: '风险清单', desc: '按市场与行业分类的出海前合规自查清单。' },
  ];
  return categories.map((c) => ({ params: { category: c.slug }, props: c }));
}

const { slug, name, desc } = Astro.props;
const nameToSlug: Record<string, string> = { 案例分析: 'cases', 法规解读: 'guides', 风险清单: 'checklists' };

const articles = (
  await getCollection('articles', ({ data }) => !data.draft && nameToSlug[data.category] === slug)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={name} description={desc}>
  <div class="masthead">
    <p class="kicker">{slug.toUpperCase()}</p>
    <h1 class="category-title"><span class="seal">{name}</span></h1>
    <p class="sub">{desc}</p>
  </div>

  <ArticleBrowser articles={articles} contextName={name} />
</Base>

<style>
  .masthead .category-title { margin: 0.6rem 0 1.1rem; }
  .category-title .seal { font-size: clamp(1.65rem, 3vw, 2rem); padding: 0.38em 0.55em; }
</style>
